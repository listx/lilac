cabal-version:  2.2

name:           lilac
version:        0.1.0.2
license:        GPL-2.0-only
license-file:   LICENSE
build-type:     Simple
extra-source-files:
  site/js/lilac.js.injectme
  src/Lilac/cli/init/only-local-imports.txt
  src/Lilac/cli/tangle/out-dir.txt
  src/Lilac/cli/weave/out-dir.txt
  src/Lilac/cli/weave/root-relative-prefix.txt
  src/Lilac/init/index.org
  src/Lilac/init/index.org-after-Lilac.toml
  src/Lilac/init/Lilac.toml
  src/Lilac/init/Lilac.toml.htmlHead.toml
  src/Lilac/init/vendor-mathjax.org
  src/Lilac/init/vendor-source-fonts.org
  src/Lilac/Serve/liveReload.js
  src/Lilac/Weave/Css/external-link.svg
  src/Lilac/Weave/Css/raw.css
  src/Lilac/Weave/defaultMathJaxSettings.js
  src/Lilac/WeaveSpec/0300-weave-lists/raw.html

common shared-properties
  default-language: GHC2024
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveAnyClass
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    EmptyCase
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    InstanceSigs
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    NoFieldSelectors
    NoImplicitPrelude
    NumDecimals
    NumericUnderscores
    LambdaCase
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RankNTypes
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TupleSections
    TypeApplications
    TypeOperators
    ViewPatterns
  ghc-options:
    -Weverything

    -Wno-unsafe -Wno-safe -Wno-missing-safe-haskell-mode

    -Wno-missed-specialisations
    -Wno-all-missed-specialisations

    -Wno-missed-extra-shared-lib
  build-depends:
      base >=4.7 && <5
    , relude

library lilac-internal
  import: shared-properties
  exposed-modules:
      Lilac.Types.Internal
  hs-source-dirs:
      src-internal
  build-depends:
      aeson
    , text

library
  import: shared-properties
  other-modules:
      Paths_lilac
  exposed-modules:
      Lilac.Version
      Lilac.Compile
      Lilac.Parse
      Lilac.Tangle
      Lilac.Types
      Lilac.Weave
      Lilac.Weave.Css
      Lilac.Util
      Lilac.Serve
  hs-source-dirs:
      src
  default-extensions:
      TemplateHaskell
  build-depends:
      aeson
    , async
    , bitwise
    , blaze-html
    , bytestring
    , citeproc
    , clay
    , containers
    , directory
    , filepath
    , file-embed
    , file-io
    , fsnotify
    , http-types
    , lilac-internal
    , toml-parser
    , lucid2
    , megaparsec
    , network-uri
    , process
    , skylighting
    , stm
    , template-haskell
    , text
    , time
    , transformers
    , uuid
    , wai
    , wai-websockets
    , websockets

executable lilac
  import: shared-properties
  main-is: Main.hs
  other-modules:
      Paths_lilac
  hs-source-dirs:
      bin
  default-extensions:
      TemplateHaskell
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  build-depends:
      aeson
    , ansi-terminal
    , bytestring
    , containers
    , directory
    , filepath
    , file-embed
    , lilac
    , network-uri
    , optparse-applicative
    , megaparsec
    , stm
    , text
    , toml-parser
    , typed-process
    , uuid
    , wai-app-static
    , warp

test-suite spec
  import: shared-properties
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Lilac.CompileSpec
      Lilac.ParseSpec
      Lilac.TangleSpec
      Lilac.WeaveSpec
      SpecHook
      Paths_lilac
  hs-source-dirs:
      test
  default-extensions:
      TemplateHaskell
  ghc-options:
      -threaded
      -rtsopts
      -with-rtsopts=-N
  build-depends:
      citeproc
    , containers
    , filepath
    , file-embed
    , hspec
    , hspec-megaparsec
    , lilac
    , lilac-internal
    , megaparsec
    , network-uri
