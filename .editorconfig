root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab #
tab_width = 8

[*.sh]
indent_style = tab
tab_width = 8
[vendor-source-fonts.sh]
indent_style = unset

[site/js/lilac.js.injectme] #
insert_final_newline = false
trim_trailing_whitespace = false
end_of_line = unset
charset = unset
