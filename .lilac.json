{
    "name": "Lilac",
    "homepage": "https://git.sr.ht/~listx/lilac",
    "repo": "https://git.sr.ht/~listx/lilac",
    "version": "0.1.0.0",
    "nonTangledPathspecs": [
        ":(exclude,top).gitmodules",
        ":(exclude,top)LICENSE",
        ":(exclude,top)*.html",
        ":(exclude,top,glob)image/*.svg",
        ":(exclude,top,glob)*.org",
        ":(exclude,top)hello-world/*.org",
        ":(exclude,top)image/PNG-Gradient.png",
        ":(exclude,top)js/lilac.js.injectme",
        ":(exclude,top)bib.json",
        ":(exclude,top)csl-styles",
        ":(exclude,top)nix/sources.json",
        ":(exclude,top)nix/sources.nix",
        ":(exclude,top)resources/public"
    ],
    "bibliography": ["bib.json"],
    "citationStyle": "csl-styles/ieee.csl"
}
